<Project>

  <!-- Los archivos intermedios (obj/bin) se generan fuera de OneDrive para evitar
       superar el límite de 260 caracteres de Windows (MAX_PATH), que hace fallar
       la carga de proyectos en Visual Studio aunque "dotnet build" funcione por CLI. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <BaseIntermediateOutputPath>C:\ca-build\CleanArchitecture.Full\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>C:\ca-build\CleanArchitecture.Full\$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>

</Project>
